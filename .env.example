# Use the port Next actually bound (3000, or 3001+ if busy).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# mock | test | live. Use test with Razorpay dashboard test keys.
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leave false until the UI is Armed and you intend a real test contest.
ENABLE_RAZORPAY_WRITES=false

CRON_SECRET=

# HMAC secret for signed ds_session cookies. Change this in any shared environment.
DEMO_AUTH_SECRET=disputeshield-demo-secret
